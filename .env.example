# Supabase ダッシュボード (Project Settings > API) から取得

# 1. Project URL
SUPABASE_URL=https://your-project-id.supabase.co

# 2. API Keys の「Publishable key」を貼り付け（旧 anon key）
# ※「Secret keys (service_role)」は特権キーのため、絶対にここに設定しないでください
SUPABASE_KEY=your-publishable-key-here


# --- Supabase PostgreSQL / PDO 接続用 (Coolify & Webアプリ用) ---
DB_HOST=aws-1-ap-northeast-1.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres.your-project-id
DB_PASSWORD=your-database-password